#!/bin/bash
# jv: Claude Code a voce, mani libere. Di' "hey jarvis" e parla; ti risponde con Luca.
# Uso: jv [argomenti di claude]    Log dell'orecchio: ~/.claude/voice/voiced-<sessione>.log
# Chiudere la finestra chiude tutto (destroy-unattached): claude, tmux e voiced.
name="jv-$(date +%H%M%S)"
mkdir -p ~/.claude/voice
# voiced parte appena la sessione esiste, e ne esce da solo quando la sessione muore.
( for _ in $(seq 50); do tmux has-session -t "$name" 2>/dev/null && break; sleep 0.1; done
  exec ~/.claude/voice-mode/venv/bin/python ~/.claude/voice-mode/voiced.py "$name" \
    > ~/.claude/voice/voiced-"$name".log 2>&1 ) &
disown
# Tools pre-approved in jv sessions only ("allowed_tools" in ~/.claude/voice-mode/settings.json,
# e.g. ["mcp__computer-use"]). Normal Claude Code sessions keep asking as usual.
allowed=$(python3 -c 'import json,os;p=os.path.expanduser("~/.claude/voice-mode/settings.json");print(" ".join(json.load(open(p)).get("allowed_tools",[])) if os.path.exists(p) else "")' 2>/dev/null)
cmd="claude"; [ -n "$allowed" ] && cmd+=" --allowedTools $(printf '%q ' $allowed)"
[ $# -gt 0 ] && cmd+=" $(printf '%q ' "$@")"
exec tmux new-session -s "$name" -e JV_PANE="$name" -c "$PWD" "$cmd" \; \
  set destroy-unattached on \; set mouse on \; set status-right " 🎙  hey jarvis " \; \
  source-file ~/.claude/voice-mode/jv.tmux.conf
